{
  "name": "sdet-playwright-automation-framework",
  "version": "1.0.0",
  "description": "Scalable End-to-End Test Automation Framework built using Playwright with Cucumber (BDD) approach.",
  "main": "index.js",
  "scripts": {
    "test": "cucumber-js --require ./step-definitions/**/*.js --require ./hooks/**/*.js --format progress --format json:reports/cucumber-report.json --format rerun:@rerun.txt --retry 2",
    "test:headed": "set HEADLESS=false && npm run test",
    "test:rerun": "cucumber-js @rerun.txt --require ./step-definitions/**/*.js --require ./hooks/**/*.js",
    "report": "node report.js",
    "test:report": "npm run test && npm run report"
  },
  "keywords": [],
  "author": "Shivam Sarode",
  "license": "ISC",
  "dependencies": {
    "@cucumber/cucumber": "^12.8.0",
    "@faker-js/faker": "^8.4.1",
    "@playwright/test": "^1.59.1",
    "dotenv": "^17.4.2",
    "winston": "^3.19.0"
  },
  "devDependencies": {
    "cucumber-html-reporter": "^7.2.0"
  }
}
