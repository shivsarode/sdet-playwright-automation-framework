{
  "name": "sdet-playwright-automation-framework",
  "version": "1.0.0",
  "description": "Scalable End-to-End Test Automation Framework built using Playwright with Cucumber (BDD) approach.",
  "main": "index.js",
  "scripts": {
    "test": "cucumber-js --require ./step-definitions/**/*.js --require ./step-definitions/api/**/*.js --require ./hooks/**/*.js --format progress --format \"allure-cucumberjs/reporter\" --format summary",
    "test:headless": "set HEADLESS=true&& cucumber-js --require ./step-definitions/**/*.js --require ./step-definitions/api/**/*.js --require ./hooks/**/*.js --format progress --format \"allure-cucumberjs/reporter\" --format summary",
    "test:rerun": "cucumber-js @rerun.txt --require ./step-definitions/**/*.js --require ./step-definitions/api/**/*.js --require ./hooks/**/*.js --format progress --format \"allure-cucumberjs/reporter\" --format summary",
    "report:generate": "allure generate allure-results --clean -o allure-report",
    "report:open": "allure open allure-report",
    "report:serve": "allure serve allure-results"
  },
  "keywords": [],
  "author": "Shivam Sarode",
  "license": "ISC",
  "dependencies": {
    "@cucumber/cucumber": "^12.8.0",
    "@faker-js/faker": "^8.4.1",
    "@playwright/test": "^1.59.1",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "dotenv": "^17.4.2",
    "winston": "^3.19.0"
  },
  "devDependencies": {
    "allure-commandline": "^2.40.0",
    "allure-cucumberjs": "^3.7.0",
    "cucumber-html-reporter": "^7.2.0"
  }
}